; AFIF-PBX GSM dongle driver
; Binds Microsoft's in-box WinUSB driver to the interfaces of Huawei voice dongles (E303, E1550, E173 ...),
; so AFIF-PBX can talk to them directly - no Huawei software or COM-port driver needed.
; The catalog is signed on the installing PC with a certificate created there (private key deleted afterwards).

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
CatalogFile = afif-dongle.cat
DriverVer   = 10/22/2026,2.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Dongles,NTamd64,NTarm64

[Dongles.NTamd64]
